LITEFS_DIR="/litefs/data"
DATABASE_PATH="./prisma/data.db"
DATABASE_URL="file:./data.db?connection_limit=1"
# Note: query params (e.g. ?connection_limit=1) are stripped by getDatabaseUrl() —
# better-sqlite3 treats them as part of the filename otherwise.
CACHE_DATABASE_PATH="./other/cache.db"
SESSION_SECRET="super-duper-s3cret"
HONEYPOT_SECRET="super-duper-s3cret"
RESEND_API_KEY="re_blAh_blaHBlaHblahBLAhBlAh"

# this is set to a random value in the Dockerfile
INTERNAL_COMMAND_TOKEN="some-made-up-token"

# set this to false to prevent search engines from indexing the website
# default to allow indexing for seo safety
ALLOW_INDEXING="true"

# Tigris Object Storage (S3-compatible) Configuration
AWS_ACCESS_KEY_ID="mock-access-key"
AWS_SECRET_ACCESS_KEY="mock-secret-key"
AWS_REGION="auto"
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
BUCKET_NAME="mock-bucket"
# Separate Tigris bucket for automated SQLite backups (optional)
# BACKUP_BUCKET_NAME="mock-backup-bucket"
# BACKUP_HOUR_UTC="3"

# Google OAuth Configuration
# Get these from: https://console.developers.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Youtube API key to access youtube data api
YOUTUBE_API_KEY=""

# Site url (domain name in prd)
SITE_URL=""

# Audio Archive Configuration
AUDIO_ARCHIVE_ENABLED="false"
AUDIO_ARCHIVE_MAX_CONCURRENT="2"
AUDIO_ARCHIVE_INTERVAL_MS="60000"
AUDIO_ARCHIVE_STALE_JOB_MS="600000"

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# YouTube cookie file path for audio archiving
COOKIE_FILE_PATH="/data/youtube-cookies.txt"

# Salt for hashing client IPs stored on security events (SHA-256, first 16 hex chars).
# The same IP and salt always produce the same hash. Raw IP addresses are not stored.
# Generate a production value with: openssl rand -hex 32
IP_HASH_SALT="dev-ip-hash-salt-change-me"
