generator client {
  provider        = "prisma-client"
  previewFeatures = ["typedSql"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String            @unique
  name             String?
  disabledAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  connections      Connection[]
  passkey          Passkey[]
  password         Password?
  servicePlaylists ServicePlaylist[]
  sessions         Session[]
  image            UserImage?
  playlists        UserPlaylist[]
  userTracks       UserTrack[]
  notifications    UserNotification[]
  usageEvents      UsageEvent[]
  dailyActiveUsers DailyActiveUser[]
  roles            Role[]            @relation("RoleToUser")
}

model UsageEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trackId   String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model DailyUsageStat {
  id     String   @id @default(cuid())
  day    DateTime
  metric String
  value  Int      @default(0)

  @@unique([day, metric])
  @@index([metric, day])
}

model DailyActiveUser {
  id     String   @id @default(cuid())
  day    DateTime
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([day, userId])
  @@index([day])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserImage {
  id        String   @id @default(cuid())
  altText   String?
  objectKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Password {
  hash   String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          String   @id @default(cuid())
  action      String
  entity      String
  access      String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")

  @@unique([action, entity, access])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")
}

model Verification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  /// The type of verification, e.g. "email" or "phone"
  type      String
  /// The thing we're trying to verify, e.g. a user's email or phone number
  target    String
  /// The secret key used to generate the otp
  secret    String
  /// The algorithm used to generate the otp
  algorithm String
  /// The number of digits in the otp
  digits    Int
  /// The number of seconds the otp is valid for
  period    Int
  /// The valid characters for the otp
  charSet   String
  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Connection {
  id           String   @id @default(cuid())
  providerName String
  providerId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  tokens       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
}

model Passkey {
  id             String   @id
  aaguid         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publicKey      Bytes
  userId         String
  webauthnUserId String
  counter        BigInt
  deviceType     String
  backedUp       Boolean
  transports     String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// FTS5 virtual tables for full-text search:
// - tracks_fts: indexes Track.title, Artist.name, Album.name
// - albums_fts: indexes Album.name, Artist.name
// - artists_fts: indexes Artist.name, Artist.genre
// These are managed via triggers and require raw SQL queries (prisma.$queryRaw)
// See migration: 20251204000000_add_fts5_search

model Artist {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  bio            String?
  imageUrl       String?
  website        String?
  genre          String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tracks         Track[]
  albums         Album[]

  @@index([normalizedName])
  @@index([name])
}

model CoverImage {
  id          String   @id @default(cuid())
  contentHash String   @unique // SHA-256 hash for deduplication
  objectKey   String // Storage key for the image file
  width       Int?
  height      Int?
  format      String? // jpeg, png, etc.
  fileSize    Int? // Size in bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tracks      Track[]
  albums      Album[]

  @@index([contentHash])
}

model Album {
  id           String      @id @default(cuid())
  name         String
  artistId     String
  artist       Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  year         Int?
  coverImageId String?
  coverImage   CoverImage? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tracks       Track[]

  @@unique([artistId, name]) // Unique album identifier
  @@index([artistId, name])
  @@index([artistId])
}

model Track {
  id                    String                 @id @default(cuid())
  title                 String
  artistId              String
  artist                Artist                 @relation(fields: [artistId], references: [id], onDelete: Cascade)
  serviceId             String
  externalId            String
  serviceUrl            String?
  duration              Int?
  albumId               String? // Foreign key to Album
  albumRecord           Album?                 @relation(fields: [albumId], references: [id], onDelete: SetNull)
  coverImageId          String? // Foreign key to CoverImage
  coverImage            CoverImage?            @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  releaseDate           DateTime?
  // Basic metadata
  genre                 String?
  year                  Int?
  trackNumber           Int?
  albumArtist           String?
  // Additional metadata
  bpm                   Int?
  label                 String?
  isrc                  String?
  originalDate          DateTime?
  originalYear          Int?
  totalTracks           Int?
  totalDiscs            Int?
  lyrics                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  servicePlaylistTracks ServicePlaylistTrack[]
  service               Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  playlists             UserPlaylistTrack[]
  userTracks            UserTrack[]
  audioFiles            TrackAudioFile[]
  archiveJob            ArchiveJob?
  
  @@unique([serviceId, externalId])
  @@index([serviceId, externalId])
  @@index([updatedAt])
  @@index([createdAt])
  @@index([albumId])
  @@index([coverImageId])
  @@index([artistId])
}

model UserPlaylist {
  id          String              @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  ownerId     String
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tracks      UserPlaylistTrack[]

  @@index([ownerId])
  @@index([ownerId, updatedAt])
}

model UserPlaylistTrack {
  id         String       @id @default(cuid())
  position   Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  playlistId String
  trackId    String
  track      Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playlist   UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, position])
}

model Service {
  id          String            @id @default(cuid())
  name        String            @unique
  displayName String
  baseUrl     String
  logoUrl     String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  playlists   ServicePlaylist[]
  tracks      Track[]
  audioFiles  TrackAudioFile[]

  @@index([name])
}

model UserTrack {
  id        String    @id @default(cuid())
  userId    String
  trackId   String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
  @@index([userId, isActive])
  @@index([userId, createdAt])
}

model ServicePlaylist {
  id           String                 @id @default(cuid())
  serviceId    String
  externalId   String
  title        String
  description  String?
  thumbnailUrl String?
  channelId    String?
  channelTitle String?
  publishedAt  DateTime?
  itemCount    Int
  lastSyncedAt             DateTime?
  archiveReadyNotifiedAt   DateTime?
  isActive                 Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  ownerId      String
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  service      Service                @relation(fields: [serviceId], references: [id])
  tracks       ServicePlaylistTrack[]

  @@unique([serviceId, externalId, ownerId])
  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([serviceId, externalId])
}

model ServicePlaylistTrack {
  id           String          @id @default(cuid())
  playlistId   String
  trackId      String
  position     Int
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  thumbnailUrl String? // Temporary storage for YouTube thumbnail URL until processed
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  track        Track           @relation(fields: [trackId], references: [id])
  playlist     ServicePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@index([playlistId, isDeleted])
}

model TrackAudioFile {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Service attribution
  serviceId String? // null = local upload, otherwise references Service
  service   Service? @relation(fields: [serviceId], references: [id])

  // File storage
  objectKey String // S3 storage key
  fileName  String?
  fileSize  Int?
  mimeType  String? // audio/mpeg, audio/flac, etc.
  format    String? // "mp3", "flac", "wav", etc.

  // Audio metadata
  bitrate    Int? // kbps
  sampleRate Int? // Hz

  // Upload info
  uploadedAt DateTime @default(now())
  uploadedBy String? // userId who uploaded (for local uploads)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackId, serviceId, format]) // One file per track/service/format combination
  @@index([trackId])
  @@index([serviceId])
  @@index([format])
  @@index([trackId, format]) // Quick lookup: "get MP3 for this track"
}

model ArchiveJob {
  id             String    @id @default(cuid())
  status         String    @default("pending") // pending, processing, completed, failed
  priority       Boolean   @default(false)
  retryCount     Int       @default(0)
  errorHistory   String    @default("[]") // JSON array of error objects
  lastAttemptAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  trackId        String    @unique
  track          Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model WorkerState {
  id                 String    @id @default("singleton")
  status             String    @default("running") // running, paused, long_break
  currentlyProcessing String?
  lastQueueRun       DateTime?
  nextLongBreakAt    DateTime?
  lastStateChange    DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model YoutubeCookie {
  id        String   @id @default(cuid())
  updatedAt DateTime @default(now())
  updatedBy String   // userId who uploaded the cookie
  valid     Boolean  @default(true)
  createdAt DateTime @default(now())
}
